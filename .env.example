# Copy this file to .env.local and fill in the official SeaFresh details.
# All three values are shown publicly on the website, so they are NEXT_PUBLIC_.

# Public website address, used for SEO metadata, sitemap and Open Graph links.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# WhatsApp number in international format, digits only, no "+" or leading 0.
# Example format for South Africa: 27XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Business email address that receives enquiries.
NEXT_PUBLIC_CONTACT_EMAIL=
